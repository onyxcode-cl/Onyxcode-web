---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = [
  { title: t('process.1.title'), desc: t('process.1.desc') },
  { title: t('process.2.title'), desc: t('process.2.desc') },
  { title: t('process.3.title'), desc: t('process.3.desc') },
  { title: t('process.4.title'), desc: t('process.4.desc') },
];
---

<section class="section">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">{t('process.eyebrow')}</span>
      <h2 class="section__title">{t('process.title')}</h2>
      <p class="section__subtitle">{t('process.subtitle')}</p>
    </div>

    <ol class="process">
      {
        steps.map((step, i) => (
          <li class="process__item">
            <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__desc">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: step;
  }

  .process__item {
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--bg);
  }

  .process__num {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--brand);
  }

  .process__title {
    font-size: var(--step-1);
  }

  .process__desc {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--step-0);
  }

  @media (min-width: 768px) {
    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .process {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
