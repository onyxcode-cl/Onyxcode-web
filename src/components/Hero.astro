---
import Logo from './Logo.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const mailto = `mailto:${site.email}`;
const chips = [
  t('services.1.title'),
  t('services.2.title'),
  t('services.3.title'),
];
---

<section class="hero" id="inicio">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">{t('hero.eyebrow')}</span>

      <h1 class="hero__title">{t('hero.title')}</h1>

      <p class="hero__subtitle">{t('hero.subtitle')}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={mailto}>{t('hero.cta.primary')}</a>
        <a class="btn btn--ghost" href="#portafolio">
          {t('hero.cta.secondary')}
        </a>
      </div>

      <p class="hero__response">
        <span class="hero__dot"></span>
        {t('hero.response')}
      </p>
    </div>

    <div class="hero__panel" aria-hidden="true">
      <div class="hero__panel-inner">
        <Logo size={56} />
        <span class="hero__panel-name">{site.name}</span>
        <ul class="hero__chips">
          {
            chips.map((chip) => (
              <li class="hero__chip">{chip}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-9) var(--space-8);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -40% 0 auto;
    height: 70%;
    background: radial-gradient(
      50% 60% at 50% 0%,
      color-mix(in srgb, var(--brand) 20%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__title {
    font-size: var(--step-4);
    max-width: 15ch;
  }

  .hero__subtitle {
    margin-top: var(--space-5);
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__response {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--success);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--success) 20%, transparent);
  }

  .hero__panel {
    padding: 2px;
    border-radius: var(--radius-xl);
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--brand) 55%, transparent),
      transparent 45%
    );
    box-shadow: var(--shadow-lg);
  }

  .hero__panel-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    min-height: 320px;
    padding: var(--space-8) var(--space-6);
    text-align: center;
    border-radius: calc(var(--radius-xl) - 2px);
    background-color: var(--surface);
    background-image: radial-gradient(
        circle at 1px 1px,
        color-mix(in srgb, var(--text) 8%, transparent) 1px,
        transparent 0
      );
    background-size: 22px 22px;
  }

  .hero__panel-name {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hero__chip {
    padding: var(--space-2) var(--space-4);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--bg-elev);
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: var(--space-10) var(--space-9);
    }

    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-9);
    }
  }
</style>
